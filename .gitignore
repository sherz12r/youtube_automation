# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# tests and generated test output
/test/
/tests/
/coverage/
/test-results/
/playwright-report/
/.nyc_output/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.log
*.tsbuildinfo
.eslintcache
/.cache/
/.turbo/
/.parcel-cache/
/.vite/
/.idea/
/.vscode/
/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/

# local environment and secret files
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Runtime databases and generated server data (never deploy from Git)
/data/
**/data/
/database/
/databases/
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
