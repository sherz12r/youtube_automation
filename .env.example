# Shared platform configuration (server-only)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-7-characters
ADMIN_NAME=Main administrator
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret-and-keep-it-stable

# Shared OpenAI models and API key
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=low

# Shared Google OAuth client; every customer stores their own refresh token in Settings
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=
# Optional: used only by the main administrator; customers connect in Channel settings
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=US

# Persistent server storage
STORY_DATABASE_PATH=./data/stories.sqlite
VIDEO_STORAGE_PATH=./data/videos
YOUTUBE_UPLOAD_SESSION_PATH=./data/youtube-uploads
